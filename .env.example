# Cassette environment configuration
# Copy to .env and adjust for your setup

# Model provider: "mock" (no backend needed) or "llama_cpp_http" (requires local server)
CASSETTE_PROVIDER=mock

# llama.cpp server URL (only used when CASSETTE_PROVIDER=llama_cpp_http)
# Start with: llama-server -m model.gguf --port 8080
CASSETTE_LLAMA_CPP_URL=http://localhost:8080

# Provider HTTP timeout in seconds
CASSETTE_PROVIDER_TIMEOUT=60

# Search API URL (SearXNG instance for web research stages)
# Start with: docker run -p 8888:8080 searxng/searxng
CASSETTE_SEARCH_URL=http://localhost:8888
